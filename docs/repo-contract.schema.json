{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sigtom/repo-template/blob/main/docs/repo-contract.schema.json",
  "title": "sigtom repository contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "branch_model",
    "integration_branch",
    "stable_branch",
    "ci_runner_policy",
    "production_mutation",
    "work_branch_prefixes",
    "required_files"
  ],
  "properties": {
    "version": {"const": 1},
    "branch_model": {
      "type": "string",
      "enum": ["dev-main", "direct-main", "upstream-mirror"]
    },
    "integration_branch": {"type": "string", "minLength": 1},
    "stable_branch": {"type": "string", "minLength": 1},
    "ci_runner_policy": {"const": "self-hosted-only"},
    "production_mutation": {"const": "explicit-approval"},
    "work_branch_prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
